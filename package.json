{
  "name": "com.pmptr.teleprompter",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build:web": "webpack --mode production",
    "build:windows": "npm run build:web && electron-builder --windows --dir",
    "dist:windows": "npm run build:web && electron-builder --windows",
    "start:desktop": "concurrently \"webpack --mode development --watch\" \"wait-on dist/renderer/index.html && electron .\""
  },
  "build": {
    "appId": "com.pmptr.teleprompter",
    "productName": "CueFlow",
    "copyright": "Copyright © 2026 CueFlow",
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "desktop/**/*",
      "dist/renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CueFlow Teleprompter"
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/slider": "^5.2.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^3.37.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.29.7",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.7",
    "@react-native/eslint-config": "0.76.7",
    "@react-native/metro-config": "0.76.7",
    "@react-native/typescript-config": "0.76.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "eslint": "^8.19.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-dom": "^18.3.1",
    "react-native-web": "^0.21.4",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4",
    "wait-on": "^9.5.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": ">=18"
  }
}
